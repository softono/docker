# Coolify
APP_NAME=Coolify
APP_ENV=production
APP_KEY=generate_random_key:alnum|32
APP_BIND_HOST=127.0.0.1
APP_PORT=8000

# Existing PostgreSQL (on external `postgres` network)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=coolify
DB_USERNAME=coolify
DB_PASSWORD=CHANGE_THIS_TO_YOUR_POSTGRES_PASSWORD

# Existing Redis (on external `redis` network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_TO_YOUR_REDIS_PASSWORD

# Realtime (Coolify Soketi)
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_APP_ID=generate_random_key:alnum|32
PUSHER_APP_KEY=generate_random_key:alnum|32
PUSHER_APP_SECRET=generate_random_key:alnum|32
SOKETI_PORT=6001
SOKETI_TERMINAL_PORT=6002
SOKETI_DEBUG=false
SOKETI_HOST=0.0.0.0
