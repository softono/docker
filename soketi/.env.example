# Soketi (https://github.com/soketi/soketi)
SOKETI_BIND_HOST=127.0.0.1
SOKETI_PORT=6001
SOKETI_METRICS_PORT=9601
SOKETI_METRICS_ENABLED=1
SOKETI_DEBUG=0

SOKETI_DEFAULT_APP_ID=generate_random_key:alnum|16
