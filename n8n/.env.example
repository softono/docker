# n8n
N8N_HOST=n8n.example.com

# Timezone
TZ=Asia/Kolkata

# Existing PostgreSQL
POSTGRESDB_HOST=host.docker.internal
POSTGRESDB_PORT=5432
POSTGRESDB_DATABASE=n8n
POSTGRESDB_USER=n8n_user
POSTGRESDB_PASSWORD=CHANGE_THIS_TO_YOUR_POSTGRES_PASSWORD

# Generate with:
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_64_CHARACTER_VALUE