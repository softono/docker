# ── Server ────────────────────────────────────────────────────────────────────
# Port the OpenViking HTTP server listens on inside the container.
OPENVIKING_SERVER_PORT=8084

# Full public URL that clients (browser, CLI, agents) use to reach the server.
# Used for CORS, link generation, and OAuth redirects.
# Must match the domain/path you configure in Nginx or Apache.
OPENVIKING_PUBLIC_BASE_URL=https://memory.example.com

# ── Gateway (optional MCP gateway) ───────────────────────────────────────────
# Set to true to activate the built-in MCP gateway on OPENVIKING_GATEWAY_PORT.
OPENVIKING_GATEWAY_ENABLED=false
OPENVIKING_GATEWAY_PORT=8085

# Secret key used to authenticate gateway management requests.
OPENVIKING_GATEWAY_MANAGEMENT_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE

# Legacy encryption key — only needed if you have data from the v0.5.0 gateway.
# Remove this line after the first successful startup.
OPENVIKING_GATEWAY_ENCRYPTION_KEY=
