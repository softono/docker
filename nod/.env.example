# Nod runtime settings
PORT=4310
NOD_HOST=0.0.0.0
NOD_AUTH_TOKEN=generate_random_key:alnum|48
NOD_BROWSER_CPUS=6
NOD_WORKSPACE_CPUS=4

# Existing PostgreSQL (running in ../postgres on the external postgres network)
DATABASE_URL=postgresql://postgres:CHANGE_THIS_TO_YOUR_POSTGRES_PASSWORD@postgres:5432/nod
