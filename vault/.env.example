# ── Listener port (host side) ─────────────────────────────────────────────────
# The port exposed on 127.0.0.1 that your Nginx/Apache proxy_pass points to.
# The container always listens internally on port 80; only the host-side changes.
VAULT_PORT=8083

# Public URL of the vault (used for links, emails, and WebAuthn)
DOMAIN=https://vault.example.com

#  PostgreSQL on host OS 
# host.docker.internal resolves to your host machine from inside the container.
# Make sure PostgreSQL is configured to accept connections from Docker:
#   1. In postgresql.conf   listen_addresses = '*'  (or at least 0.0.0.0)
#   2. In pg_hba.conf       add a line like:
#        host  vaultwarden  vault_user  172.16.0.0/12  scram-sha-256
#   3. Create the DB/user (run once in psql):
#        CREATE USER vault_user WITH ENCRYPTED PASSWORD 'yourpassword';
#        CREATE DATABASE vaultwarden OWNER vault_user;
DATABASE_URL=postgresql://vault_user:CHANGE_THIS_TO_YOUR_POSTGRES_PASSWORD@host.docker.internal:5432/vaultwarden

#  Access control 
# Disable open sign-ups after creating your account
SIGNUPS_ALLOWED=true

# Admin panel token; leave empty to disable the /admin panel.
# Generate a secure token with:
#   echo -n 'MySecretPassword' | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4
ADMIN_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE


TZ=Asia/Kolkata
