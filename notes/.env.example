# ── Image version ─────────────────────────────────────────────────────────────
# Pin to a specific release tag for production stability, e.g. v0.95.0
# Leave as "latest" for the most recent release.
# Available tags: https://github.com/TriliumNext/trilium/pkgs/container/trilium
TRILIUM_VERSION=latest

# ── Timezone ──────────────────────────────────────────────────────────────────
# Standard TZ database name, e.g. Asia/Kolkata, Europe/Berlin, America/New_York
TZ=UTC

# ── Listener port (host side) ─────────────────────────────────────────────────
# The port exposed on 127.0.0.1 that your Nginx/Apache proxy_pass points to.
# The container always listens internally on 8080; only the host-side changes.
TRILIUM_PORT=8080

# ── Public URL ────────────────────────────────────────────────────────────────
# Full URL clients will reach Trilium at (after going through your reverse proxy).
# Used for CORS allow-origin headers. Set to "*" only for development.
TRILIUM_PUBLIC_URL=https://notes.example.com

# ── Instance display name ─────────────────────────────────────────────────────
# Shows in the browser tab / UI header to identify this Trilium instance.
TRILIUM_INSTANCE_NAME=My Trilium

# ── Reverse-proxy trust ───────────────────────────────────────────────────────
# Tells Trilium which upstream proxy IPs to trust for X-Forwarded-For headers.
# "loopback" is correct when Nginx/Apache runs on the host OS.
# Use a Docker subnet (e.g. 172.18.0.0/16) only if proxying via another container.
TRILIUM_NETWORK_TRUSTEDREVERSEPROXY=loopback

# ── Sync server (optional) ────────────────────────────────────────────────────
# Uncomment if this instance acts as a sync target for other Trilium clients.
# TRILIUM_SYNC_SERVER_HOST=https://notes.example.com
# TRILIUM_SYNC_TIMEOUT=30000
